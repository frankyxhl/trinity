{
  "version": 1,
  "providers": {
    "glm": {
      "cli": "{HOME}/.claude/skills/trinity/bin/glm -p",
      "supports_resume": true,
      "resume_arg": "-r",
      "timeout": 600
    },
    "minimax": {
      "cli": "{HOME}/.claude/skills/trinity/bin/minimax",
      "supports_resume": true,
      "resume_arg": "resume",
