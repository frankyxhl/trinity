    "deepseek": {
      "cli": "{HOME}/.claude/skills/trinity/bin/deepseek -p",
      "supports_resume": true,
      "resume_arg": "-r",
      "timeout": 600
    },
    "claude-code": {
      "cli": "{HOME}/.claude/skills/trinity/bin/claude-code -p",
      "supports_resume": true,
      "resume_arg": "--resume",
