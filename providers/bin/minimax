#!/bin/sh
set -eu

KEY="${MINIMAX_API_KEY:-}"
KEY_FILE="${HOME}/.secrets/minimax_api_key"

if [ -z "$KEY" ] && [ -f "$KEY_FILE" ]; then
    PERM="$(stat -c "%a" "$KEY_FILE" 2>&1)" \
        || PERM="$(stat -f "%Lp" "$KEY_FILE" 2>&1)" \
        || PERM="unknown"
    case "$PERM" in
        600|400) ;;
        unknown)
            echo "trinity-minimax: cannot stat $KEY_FILE — refusing to read for safety." >&2
            exit 1 ;;
        *)
            echo "trinity-minimax: refuse to read $KEY_FILE (perm $PERM, expected 600 or 400). Run: chmod 600 $KEY_FILE" >&2
            exit 1 ;;
    esac
    KEY="$(cat "$KEY_FILE")"
fi

if [ -z "$KEY" ]; then
    echo "trinity-minimax: no API key. Set \$MINIMAX_API_KEY or write ~/.secrets/minimax_api_key (mode 600)." >&2
    exit 1
fi

MINIMAX_API_KEY="$KEY" CODEX_PROVIDER_ROUTED=1 exec codex exec --skip-git-repo-check \
    -c "model=MiniMax-M3" \
    -c "model_provider=minimax" \
    -c "model_providers.minimax.name=MiniMax" \
    -c "model_providers.minimax.base_url=https://api.minimaxi.com/v1" \
    -c "model_providers.minimax.wire_api=responses" \
    -c "model_providers.minimax.env_key=MINIMAX_API_KEY" "$@"
